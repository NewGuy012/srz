#!/usr/bin/env bash
set -euo pipefail

if ! command -v cargo >/dev/null 2>&1 && [ -f "$HOME/.cargo/bin/cargo" ]; then
    export PATH="$HOME/.cargo/bin:$PATH"
fi

if ! command -v cargo >/dev/null 2>&1; then
    echo "Warning: cargo not found in PATH. Skipping pre-commit formatting check."
    exit 0
fi

STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.rs$' || true)
[ -n "${STAGED_RS}" ] || exit 0

UNSTAGED_RS=$(git diff --name-only | grep -E '\.rs$' || true)
PARTIAL_CONFLICT=false
while IFS= read -r file; do
    [ -n "$file" ] || continue
    if printf '%s\n' "${UNSTAGED_RS}" | grep -Fxq "$file"; then
        PARTIAL_CONFLICT=true
        break
    fi
done <<EOF
${STAGED_RS}
EOF

if [ "${PARTIAL_CONFLICT}" = "true" ]; then
    echo "==> Partially staged Rust files detected; running cargo fmt --all -- --check..."
    if ! cargo fmt --all -- --check; then
        echo "Error: Formatting mismatch while Rust files have unstaged changes. Format and re-stage before committing." >&2
        exit 1
    fi
else
    echo "==> Running cargo fmt --all on staged Rust files..."
    cargo fmt --all
    while IFS= read -r file; do
        [ -n "$file" ] && [ -f "$file" ] && git add -- "$file"
    done <<EOF
${STAGED_RS}
EOF
fi
